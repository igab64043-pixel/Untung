{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "20.x",
      "yarn": false,
      "env": {
        "EXPO_PUBLIC_OFFLINE_MODE": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "node": "20.x",
      "yarn": false
    }
  },
  "submit": {
    "production": {}
  }
}
